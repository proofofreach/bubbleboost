{
  "extends": "plasmo/templates/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "~*": ["./src/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*", ".plasmo/index.d.ts"],
  "exclude": ["node_modules"]
}
